# Cinematic stills + reel video (xAI Imagine)
XAI_API_KEY=

# NVIDIA NIM director for ultra-realistic prompts (optional; Grok is the fallback)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PROMPT_MODEL=meta/llama-3.1-70b-instruct

# Postgres in production. Leave empty to use embedded PGLite.
DATABASE_URL=

# Public origin of this app (used for Instagram media URLs)
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=

# Auth broker (optional — Google / X sign-in)
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# VITE_AUTH_ENABLED=true
